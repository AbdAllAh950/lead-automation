# --- AI (any OpenAI-compatible API). YandexGPT works from Russia without VPN:
LLM_URL=https://ai.api.cloud.yandex.net/v1/chat/completions
LLM_AUTH=Api-Key ВАШ_API_КЛЮЧ
LLM_MODEL=gpt://ВАШ_FOLDER_ID/yandexgpt/latest
# OpenAI-compatible example: LLM_URL=https://api.example.com/v1/chat/completions  LLM_AUTH=Bearer sk-...  LLM_MODEL=model-name

# --- Telegram: token from @BotFather, chat id of the manager or a group (bots like @userinfobot show it)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Sheets (service account). Empty GOOGLE_SHEET_ID = leads go to data/leads.csv
GOOGLE_SHEET_ID=
GOOGLE_CREDENTIALS_FILE=credentials.json
LEADS_CSV=data/leads.csv

# --- Web
ALLOWED_ORIGINS=*
BUSINESS_TZ=Europe/Moscow

# --- n8n (docker compose)
N8N_ENCRYPTION_KEY=замените-на-длинную-случайную-строку
N8N_PUBLIC_URL=http://localhost:5678/
